# Example values for k3s with Traefik + cert-manager TLS
#
# Copy this file and fill in your real values:
#   cp traefik.values.yaml.example traefik.values.yaml
#
# Prerequisites:
#   1. k3s cluster (ships with Traefik)
#   2. cert-manager installed:
#      kubectl apply -f https://github.com/cert-manager/cert-manager/releases/latest/download/cert-manager.yaml
#      kubectl wait --for=condition=Available deploy --all -n cert-manager --timeout=120s
#
# Deploy:
#   helm upgrade --install app helm/threadql \
#     -f helm/threadql/values.yaml \
#     -f helm/threadql/traefik.values.yaml

mysql:
  enabled: true
  rootPassword: CHANGE_ME_MYSQL_ROOT_PASSWORD
  database: threadql

haproxy:
  enabled: false

ingress:
  enabled: true
  className: traefik
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
  hosts:
    - host: threadql.example.com
      paths:
        - path: /
          pathType: Prefix
  tls:
    - secretName: threadql-tls
      hosts:
        - threadql.example.com

certManager:
  enabled: true
  email: admin@example.com
  issuerName: letsencrypt-prod
  server: https://acme-v02.api.letsencrypt.org/directory
  solvers:
    - http01:
        ingress:
          ingressClassName: traefik

env:
  APP_NAME: ThreadQL
  APP_ENV: production
  APP_KEY: "base64:GENERATE_WITH_php_artisan_key:generate_--show"
  APP_DEBUG: "false"
  APP_URL: https://threadql.example.com

  JWT_SECRET: GENERATE_A_RANDOM_64_CHAR_STRING

  LOG_CHANNEL: stderr
  LOG_LEVEL: info

  DB_CONNECTION: mysql
  # DB_HOST: auto-set when mysql.enabled
  DB_PORT: "3306"
  DB_DATABASE: threadql
  DB_USERNAME: root
  DB_PASSWORD: ""

  SESSION_DRIVER: redis
  SESSION_LIFETIME: "120"

  QUEUE_CONNECTION: redis
  CACHE_STORE: redis

  # REDIS_HOST: auto-set when redis.enabled
  REDIS_PORT: "6379"
  REDIS_PASSWORD: ""

  BROADCAST_CONNECTION: log
  FILESYSTEM_DISK: local

  BCRYPT_ROUNDS: "12"

  MASTER_ADMIN_PASSWORD: CHANGE_ME_ADMIN_PASSWORD
